      "id": "b6c6004e-55c6-4789-a40c-c7ec1b4f8a26",
      "name": "Listar Docs da pasta",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        260,
        100
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "TROCAR",
          "name": "Google Drive (trocar)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Em execução manual (teste) reindexa tudo; no agendamento, só o que mudou nas últimas 26h.\nconst manual = $execution.mode === 'test';\nconst cutoff = Date.now() - 26 * 3600 * 1000;\nreturn $input.all().filter(i =>\n  i.json.mimeType === 'application/vnd.google-apps.document' &&\n  (manual || new Date(i.json.modifiedTime).getTime() > cutoff)\n);"
      },
      "id": "b7e3667d-1d73-4fc5-b5d4-4886aa16b9d7",
      "name": "Selecionar docs alterados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        100
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "2ef81703-570f-4fd0-be5b-8ced74cd4d76",
      "name": "Loop Over Files",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        740,
        100
      ]
    },
    {
      "parameters": {
        "url": "=https://www.googleapis.com/drive/v3/files/{{ $json.id }}/export?mimeType=text/markdown",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "timeout": 120000
        }
      },
      "id": "e0545f69-6102-480e-beb4-6a0232d40ddf",
      "name": "Exportar Doc (markdown)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        120
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "TROCAR",
          "name": "Google Drive (trocar)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://SEU-PROJETO.supabase.co/rest/v1/rpc/delete_by_file",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_file_id: $('Loop Over Files').item.json.id }) }}",
        "options": {}
      },
      "id": "37175ff3-5e2b-4bb9-b0bb-16c436304ed8",
      "name": "Apagar vetores antigos do Doc",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1240,
        120
      ],
      "credentials": {
        "supabaseApi": {
          "id": "TROCAR",
          "name": "Supabase (trocar)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const file = $('Loop Over Files').item.json;\nlet md = $('Exportar Doc (markdown)').item.json.data || '';\n\n// Remove imagens (o export do Docs embute base64 gigante) e links de imagem.\nmd = md.replace(/\\r/g, '')\n       .replace(/^\\[[^\\]]+\\]:\\s*<?data:image[^\\n]*$/gim, '')\n       .replace(/!\\[[^\\]]*\\]\\[[^\\]]*\\]/g, '')\n       .replace(/!\\[[^\\]]*\\]\\([^)]*\\)/g, '');\n\nconst MAX = 1000;\nconst base = file.name;\n\n// 1) Quebra por títulos, guardando o caminho (H1 > H2 > H3)\nconst sections = [];\nlet path = [];\nlet buf = [];\nconst flush = () => {\n  const t = buf.join('\\n').trim();\n  if (t) sections.push({ secao: path.filter(Boolean).join(' > '), text: t });\n  buf = [];\n};\nfor (const line of md.split('\\n')) {\n  const m = line.match(/^(#{1,6})\\s+(.*)$/);\n  if (m) {\n    flush();\n    const lvl = m[1].length;\n    path = path.slice(0, lvl - 1);\n    path[lvl - 1] = m[2].trim().replace(/[*_`\\\\]/g, '');\n  } else {\n    buf.push(line);\n  }\n}\nflush();\n\n// 2) Quebra seções longas por parágrafo (<= MAX caracteres), com prefixo de contexto\nconst out = [];\nfor (const s of sections) {\n  const prefix = `[${base}${s.secao ? ' > ' + s.secao : ''}]\\n`;\n  const pieces = [];\n  let cur = '';\n  for (const para of s.text.split(/\\n{2,}/)) {\n    if (para.length > MAX) {\n      if (cur) { pieces.push(cur); cur = ''; }\n      for (let i = 0; i < para.length; i += MAX - 100) pieces.push(para.slice(i, i + MAX));\n    } else if ((cur + '\\n\\n' + para).length > MAX && cur) {\n      pieces.push(cur);\n      cur = para;\n    } else {\n      cur = cur ? cur + '\\n\\n' + para : para;\n    }\n  }\n  if (cur) pieces.push(cur);\n  for (const p of pieces) {\n    if (p.trim().length < 40) continue;\n    out.push({ json: {\n      text: prefix + p.trim(),\n      file_id: file.id,\n      base,\n      secao: s.secao,\n      modified: file.modifiedTime,\n      url: file.webViewLink || `https://docs.google.com/document/d/${file.id}/edit`\n    }});\n  }\n}\nif (!out.length) return [{ json: { text: `[${base}] (documento sem texto indexável)`, file_id: file.id, base, secao: '', modified: file.modifiedTime, url: '' } }];\nreturn out;"
      },
      "id": "1c3507da-4128-49c2-be9b-96e4dca0c252",
