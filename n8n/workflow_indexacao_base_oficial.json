    {
      "parameters": {},
      "id": "2a4ae75d-65ba-4980-99f3-edf238eb6ce1",
      "name": "Reindexar tudo (manual)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "returnAll": true,
        "filter": {
          "folderId": {
            "__rl": true,
            "mode": "id",
            "value": "COLE_AQUI_O_ID_DA_PASTA_Bases_de_ERP_CXpert"
          },
